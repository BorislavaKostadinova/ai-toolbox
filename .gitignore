# ==========================================
# AI ToolBox - Git Ignore
# Laravel + Next.js + Docker
# ==========================================

# --------------------------
# OS / IDE
# --------------------------
.DS_Store
Thumbs.db
desktop.ini

.idea/
.vscode/
*.swp
*.swo


# --------------------------
# Laravel / PHP
# --------------------------
backend/vendor/

backend/storage/*.key
backend/storage/logs/*
backend/storage/framework/cache/*
backend/storage/framework/sessions/*
backend/storage/framework/views/*

!backend/storage/logs/.gitignore
!backend/storage/framework/cache/.gitignore
!backend/storage/framework/sessions/.gitignore
!backend/storage/framework/views/.gitignore

backend/bootstrap/cache/*.php

# PHPUnit
backend/.phpunit.cache/
backend/.phpunit.result.cache

# Laravel IDE helper
backend/_ide_helper.php
backend/_ide_helper_models.php
backend/.phpstorm.meta.php

# --------------------------
# Next.js / Node
# --------------------------
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/dist/
frontend/build/

# Next.js / Vercel
frontend/.vercel/

# Node logs
frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*
frontend/pnpm-debug.log*

# TypeScript
frontend/*.tsbuildinfo
frontend/next-env.d.ts

# --------------------------
# Coverage / tests
# --------------------------
coverage/
frontend/coverage/
backend/coverage/

# --------------------------
# Logs
# --------------------------
*.log
logs/

# --------------------------
# Temporary files
# --------------------------
*.tmp
*.temp
*.bak
*.cache
*.pid

tmp/
temp/

# --------------------------
# Docker local overrides
# --------------------------
docker-compose.override.yml

# --------------------------
# WSL / Windows
# --------------------------
*.Zone.Identifier